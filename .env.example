# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Obrigatório -- chave da API da Anthropic (console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Obrigatório -- login do sistema (protege o app publicado na internet: sem
# isso, qualquer pessoa com o link poderia subir documentos de terceiros e
# gastar sua chave da Anthropic). Escolha um usuário/senha fortes.
APP_USERNAME=defina-um-usuario
APP_PASSWORD=defina-uma-senha-forte

# Obrigatório em produção (hospedagem pública) -- string aleatória fixa usada
# para assinar o cookie de sessão do login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sem isso, a sessão de todo mundo cai a cada reinício/deploy do servidor.
SECRET_KEY=troque-por-uma-string-aleatoria-longa

# Defina como "production" na hospedagem pública (Render/Railway/etc.) --
# ativa o cookie de sessão "Secure" (só trafega por HTTPS). Deixe vazio/sem
# definir no seu computador (localhost não tem HTTPS).
APP_ENV=production

# Opcional -- conexão com o SharePoint (ver "OPCIONAL - Conectar a uma pasta
# do SharePoint" em COMO_USAR.txt). Sem isso, o upload manual de pasta
# continua funcionando normalmente.
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_HOSTNAME=
# SHAREPOINT_SITE_PATH=
# SHAREPOINT_ROOT_FOLDER=
